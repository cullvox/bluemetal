<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="5">

  <Content>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="3/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LUCKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. GARDEN - DAY </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A person kneels in the garden. He curates his garden and the plants within it.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>SUPER: SIXTEEN WEEKS AGO</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’m exactly two dozen years and seventeen weeks old. I enjoy gardening, and making things. However this was 16 weeks ago. That was back when I had a regulated nervous system.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="IAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="KIMBERLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LUCKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="NICK">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SHELLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="UNKNOWN PERSON">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. Work - Day</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>SUPER: NOW</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A series of people walk past each greeting him with mostly the same variations.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hello Shelly.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>SHELLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hey Lucky.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hello Kimberly.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KIMBERLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hello Lucky.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hello Ian.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>IAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yo Lucky.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hello- um hey, could you-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>UNKNOWN PERSON</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It’s Dan. I hired you.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dan gestures. An awkward moment passes.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dan intends for Lucky to continue the morning greeting.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh, right. Hello Dan.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hello Lucky.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Um- Hello Nick.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NiCK</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It’s Nile, but close enough.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>They probably don’t like my performance this quarter, it’s only been sixteen weeks, but that’s enough to make an impression.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1 2/8" Page="2" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LUCKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="NILE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. MEETING - DAY</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Lucky, you’ve clearly made </Text>
      <Text Style="Italic">an </Text>
      <Text>impression.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How’s my performance been?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We don’t like your performance this quarter either.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Is there-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Before you ask if there’s anything you can do better. Firstly your spread sheets require a bit of reordering, sometimes it’s difficult to understand the concepts you’re trying to get across. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He pulls out an example of a graph an points.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Here, time is always on the bottom of the graph. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Is there anything else.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Multiple people walk in and sit down next to Dan, the room is much more unbalanced. The room seems to expand.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yes actually, we’d like it if you could talk to some of your coworkers. Firstly let’s do another example of your greeting from earlier. Not only did you forget my name, but you also got Nile’s name wrong.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I apologize for mistaking your name Nile.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Nile</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’m feeling a little less dissatisfaction than earlier. Your erratic behavior brings a unique presence to my day.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Thank you.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>NILE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I believe that Dan also has a comment.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yes. Lucky, you forgot my name this morning.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1 1/8" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BULLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="FRIEND 2">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LUCKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MOLINA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. HOME - NIGHT </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lucky sits on the couch. It’s a mess by his standards, he has a unique way of keeping messes together. Towers of empty cans perfectly stacked. Wrappers perfectly collapsed piled on another. Boxes perfectly broken down.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I sometimes sit on my couch, my home is a complete mess now too. The time required to do the things that I must do is dwindling by the day since I have no peace anymore. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lucky takes a breath.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>When I was a kid people used to say things about me.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>BEGIN MONTAGE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>All characters in this montage are voiced by Lucky’s VO.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MOLINA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You have an incredible proficiency Lucky, I wouldn’t be surprised if an esteemed university made you a poster child.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>FRIEND 2</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>However so clever</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>however still small</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>you’ll grow bright</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I know you’ll get tall.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>She did have a way with words. She went insane in prison, then had a myocardial infarction from the pills they gave her.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BULLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>However so beaten</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>However so raw </Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Red and mangled to pulp</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Your smarts may be many</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Your strength is dwindling
I don’t think you’ll last long</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’m pretty sure he had a crush on me.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BULLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Uh- no I-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>END MONTAGE</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="6/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LUCKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. HOME - NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And now here I sit, my exhaustion is incredible and imperceptible.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lucky gets up from his seat and walks over to the window. He sees himself gardening?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sometimes I think about that moment sixteen weeks ago when I was sitting in my garden. There was a lot less to think about and a lot less to do. That was when I was emotionally regulated.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He takes a breath.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I look forward to the possibility of having that capability in the future. When I could just... be.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He looks down and takes another breath. The kitchen sink is just under the window.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY (V.o.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How could I forget my dishes.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>One fork, one spoon, one plate, one sponge.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He cleans them all precisely.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I think I need to talk to someone.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1 4/8" Page="5" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LUCKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="THERAPIST">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. Therapist - day</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>THERAPIST</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Nice to meet you Lucky.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Wish I could say the same.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>THERAPIST</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What brings you here?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sixteen weeks ago I started a new job. From then on things have gotten significantly more complicated in my life. I no longer have the energy to do the things I once loved to do. Everyday I sit in solipsist sequences of mental torture. I gaze at that garden every day with immense tire and desire.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>THERAPIST</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sounds like you’ve been going through a lot lately. Sixteen weeks is surely enough time to make an impression.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That’s what I’ve been thinking. They’ve made it clear that that don’t like my work. My </Text>
      <Text AdornmentStyle="-1">spreadshee</Text>
      <Text>-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>THERAPIST</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That’s not what I mean. I mean that the job made an impression on </Text>
      <Text Style="Italic">you</Text>
      <Text>. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So you’re saying that things have changed. I’ve changed.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>THERAPIST</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yes, and what else do you see?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I have to keep going, I see a lot more work in my future.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>THERAPIST</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Agreed, chances are you’re going to need to put more work into your everyday life because you wish to affect change.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That annoys me, I’m discontinuing this session. I shouldn’t need to put more work in. I’m already tired.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>THERAPIST</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That’s exactly how it starts.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’m decidedly against that line of thinking. Have a good day.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>THERAPIST</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Enjoy your day too.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I will not.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>They shake hands and Lucky leaves.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="7/8" Page="6" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LUCKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MOLINA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. FRIENDS house - dusk</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lucky and Molina have a beer, a root beer.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Molina</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So you just up and left?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Molina is an expert in radio communication, it’s given him strange skills at communicating with other people too. He’s also sort of a genius.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That’s exactly what I did.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MOLINA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So what’s the plan?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Continue my thinking process.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MOLINA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How often would you say your thoughts are about work?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Every day for multiple hours.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MOLINA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Is it stifling?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yes.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MOLINA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Perhaps you should think about the fact that you’re thinking too much about work.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Fascinating, maybe I’ll try that.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="3/8" Page="7" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LUCKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. DARK ROOM - MORNING</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lucky lays on the ground convulsing. So deep in thought that he can’t move or think about anything else, his eyes spiral forever inward on the thoughts about thoughts about thoughts.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He mumbles to himself about the inner workings of how he’s thinking about himself thinking about working. Impossible fractional multitudinous thinking.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>His watch alarms him to the time of day. The watch clearly says “WORK!”.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>WORK! GOD DAMNIT.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="7" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. WORK - DAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lucky is dressed well enough, but his face is dark and eyes sunken in. Clearly in distress.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="4/8" Page="8" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="IAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="KIMBERLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LUCKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SHELLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. Work - DAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A series of people walk past each greeting him with mostly the same variations.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hello uh-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>SHELLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hey- Lucky.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>They see him in his state. Some don’t respond.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hello Shells.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KIMBERLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It’s- Kimberly.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hello Ian.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>IAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yo Lucky.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You look terrible.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1 4/8" Page="8" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LUCKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="THERAPIST">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. TheRAPIST OFFICE - DAY</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I feel terrible, worse than when we last talked about putting more work in. I thought a lot about work and my thoughts about work. It didn’t work. Is this just A NATURAL BYPRODUCT OF THE MODERN WORLD?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>THERAPIST</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You’re a natural byproduct of the modern world. The work is the product. You should stop.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Stop what?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>THERAPIST</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Thinking about work.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>There are so many more things to think about. How am I supposed to fix things if I can’t think about these things.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>THERAPIST</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Here’s what I suggest, let go.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Of what?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>THERAPIST</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The stipulations, the thinking, the process, surrender to the universe. Please, continue to do great things, but your overthinking isn’t required for you to be incredible.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Surrender? Like give up?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>THERAPIST</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No. Just stop.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It’s taking a lot of work to not discontinue this conversation.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>THERAPIST</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It’s worth it to stay in this discussion, challenge is where you thrive.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You’re right.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>THERAPIST</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Using time for needless thinking takes away time for you to commit to action.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What kinds of actions.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>THERAPIST</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Thinking is an action, and it takes up slots of thought process. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I think I understand now. Thank you doctor.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>THERAPIST</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>See you next week?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Maybe.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="6/8" Page="10" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LUCKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MOLINA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. MOLINA’S HOUSE - DAY</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MoLINA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So the doc told you to surrender to the universe?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’m not sure I entirely understand what that means.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MOLINA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, I’m also a master of communication. So from what I can decipher, the doctors really trying to tell you to relax, in words that you can understand.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Relax? How can I?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MOLINA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The things that you think matter, don’t need to matter as much, especially if it’s causing you so much pain.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Okay. I think I understand.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MOLINA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Just go outside, tend to your garden, thinking about work after hours will only slow you down.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="6/8" Page="10" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="IAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="KIMBERLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LUCKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SHELLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. WORK - DAY</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A series of people walk past each greeting him with mostly the same variations.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hello Shelly.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>SHELLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hey Lucky.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hello Kimberly.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KIMBERLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hello Lucky.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hello Ian.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>IAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yo Lucky.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hello Dan.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You look good. It’s nice to see you Lucky.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Seeing you doesn’t bring me as much pleasure as you announce. I’m here to help and make money.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The honesty is appreciated. I’ll talk to you later.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2/8" Page="11" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="LUCKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. GARDEN - AFternoon</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>LUCKY (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The garden is nice when I can sit within it.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lucky takes a breath.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He looks up. Things are starting to look up.</Text>
    </Paragraph>
  </Content>

