    <DisplayBoard Height="10000" Id="ea5ac6af-4926-415c-897c-51bfeff25831" ScrollOrigin="1339,496" Type="Beat" Width="24000" ZoomLevel="110.276">
      <Item Height="280" Id="d8118625-bdda-4372-ab5c-1fae7373595d" Left="1940" Top="740" Width="320"/>
